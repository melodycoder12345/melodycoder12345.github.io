{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge:validate": "node scripts/validate-knowledge.js",
    "knowledge:build": "node scripts/build-knowledge.js",
    "knowledge:generated:check": "node scripts/check-generated-knowledge.js",
    "knowledge:check": "npm run knowledge:validate && npm run knowledge:generated:check && npm test",
    "layout:audit": "node scripts/layout-audit.js",
    "layout:audit:json": "node scripts/layout-audit.js --json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.js",
    "test:all": "vitest run && playwright test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "snapshots:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "serve": "^14.2.6",
    "vitest": "^2.0.0"
  }
}
