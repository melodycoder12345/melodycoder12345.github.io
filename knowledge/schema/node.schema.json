{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge node",
  "type": "object",
  "required": ["id", "label", "module", "type", "href", "desc"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "minLength": 1 },
    "type": { "enum": ["module", "page"] },
    "href": { "type": "string", "pattern": "\\.html$" },
    "desc": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["algorithm", "data-structure", "mechanism", "protocol", "system", "practice"] },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["article", "diagram", "animation", "code", "comparison", "lab"] }
    },
    "interaction": { "enum": ["none", "stepper", "simulator", "playground"] },
    "embeddedDemos": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\.html$" }
    },
    "learning": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "orientation": {
          "type": "object",
          "required": ["background", "problem", "position", "questions"],
          "properties": {
            "background": { "type": "string", "minLength": 1 },
            "problem": { "type": "string", "minLength": 1 },
            "position": { "type": "string", "minLength": 1 },
            "questions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
