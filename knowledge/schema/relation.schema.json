{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge relation",
  "type": "object",
  "required": ["id", "source", "target", "type", "summary", "strength", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "type": { "enum": ["prerequisite", "mechanism", "causal", "composition", "application", "contrast", "analogy"] },
    "summary": { "type": "string", "minLength": 1 },
    "strength": { "type": "integer", "minimum": 1, "maximum": 3 },
    "status": { "enum": ["generated", "reviewed"] },
    "details": { "type": "object" }
  }
}
